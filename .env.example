# Copie este arquivo para ".env" (o .env NUNCA vai para o Git) e preencha os valores.
# Formato: NOME=valor  (sem aspas e sem espaços ao redor do "=")

# --- Sponte (WSAPIEdu) ---
SPONTE_COD_CLIENTE=000000
SPONTE_TOKEN=cole_o_token_aqui

# --- PostgreSQL (DW) ---
PG_HOST=localhost
PG_PORT=5432
PG_DB=sponte_dw
PG_USER=postgres
PG_PASSWORD=sua_senha_do_postgres
